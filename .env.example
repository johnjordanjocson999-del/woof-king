# Copy to .env before running.
#
# Local (SQLite): change prisma/schema.prisma provider to "sqlite" and use:
# DATABASE_URL="file:./dev.db"
#
# Production (Supabase / Postgres on Vercel):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true"
# Direct (non-pooler) URL — required for prisma db push / migrate
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# 32+ character random string. Signs session cookies and order access tokens.
APP_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public origin, used to build PayMongo return URLs.
APP_URL="http://localhost:3000"

# Optional. Leave blank to keep using Manual GCash / Mock payments.
# A sk_test_ key needs no business registration and is safe for development.
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# Protects the scheduled job endpoint at /api/cron.
CRON_SECRET="change-me-too"

# Optional on your laptop (local uploads go to public/uploads).
# Required on Vercel: Storage → Create Blob store → connect to this project.
# Vercel injects BLOB_READ_WRITE_TOKEN automatically after you create the store.
# BLOB_READ_WRITE_TOKEN=""
